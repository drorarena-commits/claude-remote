@echo off
rem Stage 1 draft - replaces the Startup-folder comax-agent.cmd ("יוני קומקס").
rem chcp 65001 must come first: cmd reads the rest of this file in the active
rem code page, and the Hebrew --name below is UTF-8.
rem --capacity 1 until Dror decides otherwise (decision e, 29/09/2026).
rem --spawn=same-dir only - never worktree: runs\.lock, data\ and content\ do
rem not exist in a worktree copy.
chcp 65001 >nul
cd /d C:\AGENT-COMAX-CLOAD
claude remote-control --name "יוני קומקס" --spawn=same-dir --capacity 1 --permission-mode default --debug-file C:\claude-remote\logs\yoni-debug.log
